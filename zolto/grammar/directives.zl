# Directive grammar
# All @keyword … @/keyword block forms.

@diagram <type> [id="..."] [theme="..."] [layout="..."] [aria="..."]
  node <id> [label="..." shape="..."]
  edge <from> -> <to> [label="..."]
  group <group_id> [label="..."]
    <node_id>
  @/group
  cluster <cluster_id> [label="..."]
    <node_declarations>
  @/cluster
  ref <original_id> as <alias>
@/diagram

@chart <type> [title="..."] [subtitle="..."] [theme="..."] [width=N] [height=N] [responsive=true|false] [animation=true|false] [legend=true|false] [colors=[...]]
labels:
  <label_1>
  <label_2>

data:
  <value_1>
  <value_2>

series:
  - name: "<series_name>"
    data: <val_1> <val_2>

source: <csv|tsv|json>
  <raw_data_content>
@/chart
